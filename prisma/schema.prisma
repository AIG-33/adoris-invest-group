generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // --- Добавленные поля ---
  role      String   @default("user")
  updatedAt DateTime @default(now()) @updatedAt
  // ------------------------

  // --- Profile fields for orders ---
  firstName     String?
  lastName      String?
  company       String?
  vatId         String?
  phone         String?
  address       String?
  city          String?
  postalCode    String?
  country       String? @default("Poland")
  department    String?
  paymentMethod String? @default("bank_transfer")
  // --------------------------------

  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  domain         String    @unique
  logo           String?
  language       String    @default("en") // "en" or "ru"
  priceType      String    @default("EU") // "EU" or "RU"
  email          String?
  phone          String?
  address        String?   @db.Text
  primaryColor   String?   @default("#333333") // Primary brand color
  secondaryColor String?   @default("#666666") // Secondary brand color
  accentColor    String?   @default("#000000") // Accent color
  showPrices     Boolean   @default(true) // Show prices or "Price on Request"
  googleAnalyticsId String? // Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
  yandexMetrikaId  String? // Яндекс.Метрика counter ID
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  products       Product[]
  orders         Order[]

  @@index([domain])
  @@index([slug])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@index([slug])
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  Product[]

  @@index([slug])
}

enum StockStatus {
  in_stock
  out_of_stock
  pre_order
}

model Product {
  id             String       @id @default(cuid())
  sku            String       @unique
  name           String
  slug           String       @unique
  description    String?      @db.Text
  priceEU        Decimal      @db.Decimal(10, 2) // Price for EU companies
  priceRU        Decimal?     @db.Decimal(10, 2) // Price for RU companies (optional)
  image          String?
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId String
  company        Company?     @relation(fields: [companyId], references: [id])
  companyId      String?
  stockStatus    StockStatus  @default(in_stock)
  stockQuantity  Int          @default(0)
  featured       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  orderItems     OrderItem[]

  @@index([featured])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([slug])
  @@index([priceEU])
  @@index([priceRU])
  @@index([createdAt])
  @@index([name])
  @@index([sku])
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  company        Company?    @relation(fields: [companyId], references: [id])
  companyId      String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  billingAddress String?     @db.Text
  status         OrderStatus @default(pending)
  subtotal       Decimal     @db.Decimal(10, 2)
  tax            Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
}
