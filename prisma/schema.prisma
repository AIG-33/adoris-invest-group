generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // --- Добавленные поля ---
  role      String   @default("user")
  updatedAt DateTime @default(now()) @updatedAt
  // ------------------------

  // --- Profile fields for orders ---
  firstName     String?
  lastName      String?
  company       String?
  vatId         String?
  phone         String?
  address       String?
  city          String?
  postalCode    String?
  country       String? @default("Poland")
  department    String?
  paymentMethod String? @default("bank_transfer")
  // --------------------------------

  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  domain         String    @unique
  logo           String?
  language       String    @default("en") // "en" or "ru"
  priceType      String    @default("EU") // "EU" or "RU"
  email          String?
  phone          String?
  address        String?   @db.Text
  primaryColor   String?   @default("#333333") // Primary brand color
  secondaryColor String?   @default("#666666") // Secondary brand color
  accentColor    String?   @default("#000000") // Accent color
  showPrices     Boolean   @default(true) // Show prices or "Price on Request"
  googleAnalyticsId String? // Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
  yandexMetrikaId  String? // Яндекс.Метрика counter ID
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  products       Product[]
  orders         Order[]
  mailboxes      Mailbox[]
  replyTemplates ReplyTemplate[]

  @@index([domain])
  @@index([slug])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@index([slug])
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  Product[]

  @@index([slug])
}

enum StockStatus {
  in_stock
  out_of_stock
  pre_order
}

model Product {
  id             String       @id @default(cuid())
  sku            String       @unique
  name           String
  slug           String       @unique
  description    String?      @db.Text
  priceEU        Decimal      @db.Decimal(10, 2) // Price for EU companies
  priceRU        Decimal?     @db.Decimal(10, 2) // Price for RU companies (optional)
  /// Legacy column still present on many DBs; must match priceEU on every write
  price          Decimal      @default(0) @db.Decimal(10, 2)
  image          String?
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId String
  company        Company?     @relation(fields: [companyId], references: [id])
  companyId      String?
  stockStatus    StockStatus  @default(in_stock)
  stockQuantity  Int          @default(0)
  featured       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  orderItems     OrderItem[]
  rfqItems       PriceRequestItem[]

  @@index([featured])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([slug])
  @@index([priceEU])
  @@index([priceRU])
  @@index([createdAt])
  @@index([name])
  @@index([sku])
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  company        Company?    @relation(fields: [companyId], references: [id])
  companyId      String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  billingAddress String?     @db.Text
  status         OrderStatus @default(pending)
  subtotal       Decimal     @db.Decimal(10, 2)
  tax            Decimal     @db.Decimal(10, 2)
  logisticFee    Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Inbound price-request (RFQ) email automation
// ---------------------------------------------------------------------------

model Mailbox {
  id              String         @id @default(cuid())
  email           String         @unique
  displayName     String?
  company         Company?       @relation(fields: [companyId], references: [id])
  companyId       String?
  /// off | monitor | drafts | auto
  mode            String         @default("drafts")
  /// "auto" = reply in the customer's language, otherwise ISO code (en, pl, de, ru…)
  replyLanguage   String         @default("auto")
  signatureHtml   String?        @db.Text
  /// Newline-separated emails or @domains that are never processed
  excludedSenders String?        @db.Text
  /// Extra Gmail search filter, e.g. "label:rfq"
  gmailQuery      String?
  backfillDays    Int            @default(3)
  refreshTokenEnc String?        @db.Text
  historyId       String?
  lastSyncAt      DateTime?
  lastError       String?        @db.Text
  lastErrorAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  emails          InboundEmail[]
}

model InboundEmail {
  id              String             @id @default(cuid())
  mailbox         Mailbox            @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId       String
  gmailMessageId  String
  gmailThreadId   String
  rfcMessageId    String?
  references      String?            @db.Text
  fromEmail       String
  fromName        String?
  toEmail         String?
  subject         String             @default("")
  receivedAt      DateTime
  snippet         String?            @db.Text
  bodyText        String?            @db.Text
  bodyHtml        String?            @db.Text
  /// new | processing | ignored | not_rfq | draft_ready | needs_review | sent_auto | sent_manual | rejected | error
  status          String             @default("new")
  ignoreReason    String?
  isPriceRequest  Boolean?
  confidence      Float?
  language        String?
  customerName    String?
  customerCompany String?
  aiSummary       String?            @db.Text
  aiRaw           Json?
  model           String?
  promptVersionId String?
  attempts        Int                @default(0)
  error           String?            @db.Text
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  attachments     EmailAttachment[]
  items           PriceRequestItem[]
  replies         OutboundReply[]

  @@unique([mailboxId, gmailMessageId])
  @@index([status])
  @@index([receivedAt])
  @@index([gmailThreadId])
}

model EmailAttachment {
  id                String       @id @default(cuid())
  email             InboundEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId           String
  filename          String
  mimeType          String
  size              Int          @default(0)
  gmailAttachmentId String?      @db.Text
  /// pending | text | sent_to_ai | skipped | error
  status            String       @default("pending")
  extractedText     String?      @db.Text
  error             String?      @db.Text
  createdAt         DateTime     @default(now())

  @@index([emailId])
}

model PriceRequestItem {
  id               String       @id @default(cuid())
  email            InboundEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId          String
  position         Int          @default(0)
  requestedSku     String
  quantity         Int          @default(1)
  description      String?      @db.Text
  manufacturerHint String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId        String?
  matchedSku       String?
  productName      String?
  unitPrice        Decimal?     @db.Decimal(10, 2)
  currency         String       @default("EUR")
  /// found | not_found | no_price
  status           String
  verifiedInText   Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([emailId])
  @@index([status])
  @@index([productId])
}

model OutboundReply {
  id              String       @id @default(cuid())
  email           InboundEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId         String
  /// draft | sent | discarded | error
  status          String       @default("draft")
  toEmail         String
  subject         String
  bodyHtml        String       @db.Text
  aiDraftHtml     String       @db.Text
  /// auto | manual
  sendMode        String?
  edited          Boolean      @default(false)
  sentByEmail     String?
  sentAt          DateTime?
  gmailMessageId  String?
  gmailThreadId   String?
  promptVersionId String?
  templateId      String?
  error           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([emailId])
  @@index([status])
}

model AiPromptVersion {
  id          String   @id @default(cuid())
  /// classify | reply
  kind        String
  version     Int
  text        String   @db.Text
  comment     String?
  authorEmail String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([kind, version])
  @@index([kind, isActive])
}

model ReplyTemplate {
  id        String   @id @default(cuid())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?
  /// ISO language code, "en" is the fallback
  language  String   @default("en")
  subject   String
  bodyHtml  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([companyId, language])
}

model AutomationSettings {
  id                  String   @id @default("global")
  autoSendEnabled     Boolean  @default(false)
  model               String   @default("gpt-4.1")
  confidenceThreshold Float    @default(0.8)
  updatedByEmail      String?
  updatedAt           DateTime @default(now()) @updatedAt
}

model AutomationLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  userEmail String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
